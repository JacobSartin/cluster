{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  automergeType: "pr",
  automergeStrategy: "squash",
  platformAutomerge: false,
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: "Merge routine dependency updates after validation",
      matchUpdateTypes: ["digest", "patch", "minor", "pin", "pinDigest"],
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      description: "Require manual review for major dependency updates",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["manual"],
      assignees: ["JacobSartin"],
    },
  ],
}
